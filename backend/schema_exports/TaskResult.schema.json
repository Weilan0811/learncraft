{
  "$defs": {
    "ExportFile": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "pdf",
            "slide_json",
            "image_assets",
            "pptx",
            "markdown",
            "html"
          ],
          "title": "Type",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "type",
        "url"
      ],
      "title": "ExportFile",
      "type": "object"
    },
    "TaskStatus": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed"
      ],
      "title": "TaskStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/TaskStatus"
    },
    "content_type": {
      "enum": [
        "lecture",
        "slide_deck",
        "social_post",
        "podcast_script",
        "video_script",
        "project_task",
        "quiz_pack",
        "learning_path"
      ],
      "title": "Content Type",
      "type": "string"
    },
    "preview_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preview Url"
    },
    "export_files": {
      "items": {
        "$ref": "#/$defs/ExportFile"
      },
      "title": "Export Files",
      "type": "array"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "current_node": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Node"
    },
    "progress": {
      "additionalProperties": true,
      "title": "Progress",
      "type": "object"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    }
  },
  "required": [
    "task_id",
    "status",
    "content_type"
  ],
  "title": "TaskResult",
  "type": "object"
}