      "required": [
        "element_id",
        "type",
        "title",
        "purpose",
        "instruction",
        "source_unit_id",
        "source_outline_unit_id"
      ],
      "title": "RequiredElementSpec",
      "type": "object"
    },
    "TextBlock": {
      "additionalProperties": false,
