    "source_chunk_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Chunk Ids",
      "type": "array"
    }
  },
  "required": [
    "id",
    "title",
    "summary"
  ],
  "title": "LectureSection",
  "type": "object"
}