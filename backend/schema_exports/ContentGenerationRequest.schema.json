{
  "$defs": {
    "GenerationOptions": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "default": "zh-CN",
          "title": "Language",
          "type": "string"
        },
        "audience": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audience"
        },
        "difficulty": {
          "default": "introductory",
          "enum": [
            "introductory",
            "intermediate",
            "advanced"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "style": {
          "default": "educational",
          "title": "Style",
          "type": "string"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Minutes"
        },
        "section_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Count"
        },
        "slide_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slide Count"
        },
        "max_section_count": {
          "default": 8,
          "title": "Max Section Count",
          "type": "integer"
        },
        "max_slide_count": {
          "default": 12,
          "title": "Max Slide Count",
          "type": "integer"
        },
        "output_depth": {
          "default": "standard",
          "enum": [
            "brief",
            "standard",
            "detailed"
          ],
          "title": "Output Depth",
          "type": "string"
        },
        "include_images": {
          "default": true,
          "title": "Include Images",
          "type": "boolean"
        },
        "include_charts": {
          "default": false,
          "title": "Include Charts",
          "type": "boolean"
        },
        "include_mindmap": {
          "default": false,
          "title": "Include Mindmap",
          "type": "boolean"
        },
        "image_style": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Style"
        },
        "citation_policy": {
          "default": "light",
          "enum": [
            "none",
            "light",
            "strict"
          ],
          "title": "Citation Policy",
          "type": "string"
        },
        "allow_fallback": {
          "default": false,
          "title": "Allow Fallback",
          "type": "boolean"
        },
        "slide_theme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slide Theme"
        },
        "speaker_notes": {
          "default": true,
          "title": "Speaker Notes",
          "type": "boolean"
        },
        "pdf_options": {
          "additionalProperties": true,
          "title": "Pdf Options",
          "type": "object"
        }
      },
      "title": "GenerationOptions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_type": {
      "enum": [
        "lecture",
        "slide_deck",
        "social_post",
        "podcast_script",
        "interactive_html",
        "video_script",
        "project_task",
        "quiz_pack",
        "learning_path"
      ],
      "title": "Content Type",
      "type": "string"
    },
    "topic": {
      "minLength": 1,
      "title": "Topic",
      "type": "string"
    },
    "user_prompt": {
      "minLength": 1,
      "title": "User Prompt",
      "type": "string"
    },
    "system_prompt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "System Prompt"
    },
    "knowledge_base_ids": {
      "items": {
        "type": "string"
      },
      "title": "Knowledge Base Ids",
      "type": "array"
    },
    "generation_options": {
      "$ref": "#/$defs/GenerationOptions"
    }
  },
  "required": [
    "content_type",
    "topic",
    "user_prompt"
  ],
  "title": "ContentGenerationRequest",
  "type": "object"
}