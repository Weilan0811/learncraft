{
  "$defs": {
    "AudioFileElement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "audio_file",
          "default": "audio_file",
          "title": "Type",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "status": {
          "default": "completed",
          "enum": [
            "pending",
            "generating",
            "completed",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "source_unit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Unit Id"
        },
        "source_outline_unit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Outline Unit Id"
        },
        "source_chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Chunk Ids",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "generation_info": {
          "additionalProperties": true,
          "title": "Generation Info",
          "type": "object"
        },
        "speaker": {
          "enum": [
            "Person1",
            "Person2"
          ],
          "title": "Speaker",
          "type": "string"
        },
        "voice": {
          "enum": [
            "Ethan",
            "Cherry"
          ],
          "title": "Voice",
          "type": "string"
        },
        "audio_url": {
          "title": "Audio Url",
          "type": "string"
        },
        "format": {
          "default": "mp3",
          "title": "Format",
          "type": "string"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "byte_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Size"
        },
        "order": {
          "title": "Order",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "title",
        "speaker",
        "voice",
        "audio_url",
        "order"
      ],
      "title": "AudioFileElement",
      "type": "object"
    },
    "PodcastAudioSegment": {
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "order": {
          "title": "Order",
          "type": "integer"
        },
        "speaker": {
          "enum": [
            "Person1",
            "Person2"
          ],
          "title": "Speaker",
          "type": "string"
        },
        "voice": {
          "enum": [
            "Ethan",
            "Cherry"
          ],
          "title": "Voice",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "audio_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Url"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "generated",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "retry_count": {
          "default": 0,
          "title": "Retry Count",
          "type": "integer"
        }
      },
      "required": [
        "segment_id",
        "order",
        "speaker",
        "voice",
        "text"
      ],
      "title": "PodcastAudioSegment",
      "type": "object"
    },
    "PodcastExportFile": {
      "additionalProperties": false,
      "properties": {
        "file_type": {
          "enum": [
            "script",
            "manifest",
            "audio",
            "zip"
