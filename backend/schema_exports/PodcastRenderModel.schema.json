          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "file_type"
      ],
      "title": "PodcastExportFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "render_type": {
      "const": "podcast_script",
      "default": "podcast_script",
      "title": "Render Type",
      "type": "string"
    },
    "content_type": {
      "const": "podcast_script",
      "default": "podcast_script",
      "title": "Content Type",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "podcast_name": {
      "title": "Podcast Name",
      "type": "string"
    },
    "podcast_tagline": {
      "title": "Podcast Tagline",
      "type": "string"
    },
    "script_text": {
      "title": "Script Text",
      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/PodcastAudioSegment"
      },
      "title": "Segments",
      "type": "array"
    },
    "audio_assets": {
      "items": {
        "$ref": "#/$defs/AudioFileElement"
      },
      "title": "Audio Assets",
      "type": "array"
    },
    "audio_manifest_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio Manifest Url"
    },
    "final_audio_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Audio Url"
    },
    "export_files": {
      "items": {
        "$ref": "#/$defs/PodcastExportFile"
      },
      "title": "Export Files",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "title",
    "podcast_name",
    "podcast_tagline",
    "script_text"
  ],
  "title": "PodcastRenderModel",
  "type": "object"
}