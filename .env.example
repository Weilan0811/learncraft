# 运行模式
# stub: 开发占位模式，不调用任何真实服务、无需 API Key，仅用于本地联调和自动化测试。
# real: 真实服务模式，按下方配置调用文本 / 图片 / 语音服务；演示和录制请使用 real。
CONTENT_GENERATOR_PROVIDER_MODE=stub
CONTENT_GENERATOR_ALLOW_FALLBACK=false

# 数据库
# 默认使用仓库根目录下的 SQLite，首次启动自动建表，无需额外安装数据库。
CONTENT_GENERATOR_DATABASE_URL=sqlite:///storage/tasks.db
# 改用 MySQL 时，把上面的 DATABASE_URL 留空，再配置以下变量；
# 也可以直接填写完整地址：mysql+pymysql://root:password@localhost:3306/future_learning
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=future_learning
DB_LOG_ECHO=false

# 本地存储与日志（相对路径以仓库根目录为准，与启动目录无关）
CONTENT_GENERATOR_STORAGE_ROOT=storage
CONTENT_GENERATOR_ASSET_PUBLIC_BASE_URL=/api/assets
CONTENT_GENERATOR_LOG_ROOT=storage/logs
CONTENT_GENERATOR_DEBUG_ROOT=storage/debug_workflow

# 文本模型（所有内容类型必需）
# provider 可选 bailian / deepseek，并填写对应服务商的 API Key。
CONTENT_GENERATOR_TEXT_PROVIDER=bailian
CONTENT_GENERATOR_TEXT_MODEL=qwen3.5-flash
CONTENT_GENERATOR_BAILIAN_API_KEY=
CONTENT_GENERATOR_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CONTENT_GENERATOR_DEEPSEEK_API_KEY=
CONTENT_GENERATOR_DEEPSEEK_BASE_URL=https://api.deepseek.com

# 图片生成（讲义、幻灯片、图文推文需要）
# provider 可选 apimart / bailian，并填写对应服务商的 API Key。
# 选择 bailian 时复用上方文本分组的 CONTENT_GENERATOR_BAILIAN_API_KEY。
CONTENT_GENERATOR_IMAGE_PROVIDER=apimart
CONTENT_GENERATOR_IMAGE_MODEL=gpt-image-2
CONTENT_GENERATOR_IMAGE_RESOLUTION=1k
CONTENT_GENERATOR_APIMART_API_KEY=
CONTENT_GENERATOR_APIMART_BASE_URL=https://api.apimart.ai/v1

# 语音合成（仅播客必需，目前仅支持 bailian，使用 CONTENT_GENERATOR_BAILIAN_API_KEY）
CONTENT_GENERATOR_TTS_PROVIDER=bailian
CONTENT_GENERATOR_TTS_MODEL=qwen3-tts-flash
CONTENT_GENERATOR_TTS_PERSON1_VOICE=Ethan
CONTENT_GENERATOR_TTS_PERSON2_VOICE=Cherry
CONTENT_GENERATOR_TTS_OUTPUT_FORMAT=mp3
CONTENT_GENERATOR_BAILIAN_TTS_BASE_URL=https://dashscope.aliyuncs.com
# 播客完整音频由 ffmpeg 重新编码合成；默认使用 imageio-ffmpeg 自带的二进制。
# 如需改用系统 ffmpeg，在这里填写可执行文件路径（例如 C:/ffmpeg/bin/ffmpeg.exe）。
# CONTENT_GENERATOR_FFMPEG_BINARY=

# 生成参数
CONTENT_GENERATOR_PODCAST_SEGMENT_MAX_RETRIES=1
CONTENT_GENERATOR_PODCAST_SEGMENT_RETRY_DELAY_SECONDS=10
CONTENT_GENERATOR_GENERATION_UNIT_CONCURRENCY=3
CONTENT_GENERATOR_IMAGE_GENERATION_CONCURRENCY=3
CONTENT_GENERATOR_TTS_GENERATION_CONCURRENCY=4
CONTENT_GENERATOR_PROVIDER_RATE_LIMIT_BACKOFF_SECONDS=2
CONTENT_GENERATOR_REQUEST_TIMEOUT_SECONDS=120
CONTENT_GENERATOR_MAX_RETRIES=2

# 知识库
# 当前未接入独立知识库，检索功能关闭；请求中的 knowledge_base_ids 字段保留，暂不使用。
